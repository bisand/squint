[Desktop Entry]
Type=Application
Name=squint
GenericName=Text Editor
Comment=Opens huge text files instantly, lets you look, tweak and save
Exec=squint %F
Icon=squint
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;text/x-log;text/csv;text/tab-separated-values;text/markdown;text/xml;application/xml;application/json;application/x-ndjson;application/yaml;application/x-yaml;application/toml;text/x-ini;application/sql;text/x-sql;
Keywords=text;editor;log;json;large;
StartupWMClass=squint
